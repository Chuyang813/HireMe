# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used by admin routes like storage triggers. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek API (primary AI provider when DEEPSEEK_API_KEY is set)
DEEPSEEK_API_KEY=
# Quality-first default: Pro with thinking enabled. Flash is used as the lower-cost fallback.
AI_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled
# JSON and long-form outputs default to non-thinking mode to avoid empty content when reasoning consumes output budget.
DEEPSEEK_JSON_THINKING=disabled
# Long-form document generation uses Pro with thinking disabled by default so output budget goes to the actual document.
DEEPSEEK_TEXT_THINKING=disabled
DEEPSEEK_FALLBACK_MODELS=deepseek-v4-flash

# DeepSeek embeddings for semantic evidence selection
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
DEEPSEEK_CHAT_EMBEDDING_FALLBACK_MODEL=deepseek-v4-flash
# Semantic evidence embeddings are on by default when DEEPSEEK_API_KEY is present.
ENABLE_SEMANTIC_EVIDENCE=true

# Gemini API (optional fallback only; leave ENABLE_GEMINI_FALLBACK unset for DeepSeek-only AI)
GEMINI_API_KEY=
# Default model - can be overridden per deployment.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated fallback chain for quota/capacity failures.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it
ENABLE_GEMINI_FALLBACK=false

# Claude backup provider (not active by default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# App
# Also used as the email confirmation redirect URL (emailRedirectTo in signupAction).
# Set this to your production URL in Supabase Dashboard → Authentication → URL Configuration → Site URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry error monitoring (optional — leave blank to disable)
# Get your DSN from sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
