# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used by admin routes like storage triggers. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API
GEMINI_API_KEY=
# Default model - can be overridden per deployment.
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Optional comma-separated fallback chain for quota/capacity failures.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite-preview,gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it

# Claude backup provider (not active by default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
