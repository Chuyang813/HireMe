# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used by admin routes like storage triggers. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek API (primary AI provider when DEEPSEEK_API_KEY is set)
DEEPSEEK_API_KEY=
# Cost-saving default: Flash, non-thinking mode. Set AI_PROVIDER=gemini or glm only if you want to override.
AI_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
# Leave disabled by default to avoid surprise spend on Pro.
ENABLE_DEEPSEEK_PRO_FALLBACK=false

# Gemini API (optional fallback and PDF understanding)
GEMINI_API_KEY=
# Default model - can be overridden per deployment.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated fallback chain for quota/capacity failures.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it

# Claude backup provider (not active by default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
